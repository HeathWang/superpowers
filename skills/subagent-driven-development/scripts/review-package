#!/usr/bin/env bash
# Generate a review package from two worktree snapshot trees: snapshot
# identifiers, stat summary, and the net diff with extended context, written
# to a file the reviewer reads in one call.
#
# Usage: review-package BEFORE_SNAPSHOT AFTER_SNAPSHOT [OUTFILE]
# Default OUTFILE:
# <repo-root>/.superpowers/sdd/review-<before7>..<after7>.diff
# (named per range, so a re-review after fixes gets a distinct fresh file).
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: review-package BEFORE_SNAPSHOT AFTER_SNAPSHOT [OUTFILE]" >&2
  exit 2
fi

before=$1
after=$2

before_tree=$(git rev-parse --verify "$before^{tree}") \
  || { echo "bad BEFORE_SNAPSHOT: $before" >&2; exit 2; }
after_tree=$(git rev-parse --verify "$after^{tree}") \
  || { echo "bad AFTER_SNAPSHOT: $after" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace")
  out="$dir/review-${before_tree:0:7}..${after_tree:0:7}.diff"
fi

{
  echo "# Review package: ${before_tree}..${after_tree}"
  echo
  echo "## Snapshots"
  echo "Before: ${before_tree}"
  echo "After:  ${after_tree}"
  echo
  echo "## Files changed"
  git diff --stat "$before_tree" "$after_tree"
  echo
  echo "## Diff"
  git diff -U10 "$before_tree" "$after_tree"
} > "$out"

files=$(git diff --name-only "$before_tree" "$after_tree" | wc -l | tr -d ' ')
echo "wrote ${out}: ${files} file(s), $(wc -c < "$out" | tr -d ' ') bytes"
